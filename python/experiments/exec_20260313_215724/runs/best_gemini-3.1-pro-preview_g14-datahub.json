          "params": [
            "packageId",
            "metadata"
          ]
        },
        {
          "name": "DeletePackage",
          "params": [
            "packageId",
            "permanent"
          ]
        },
        {
          "name": "RestorePackage",
          "params": [
            "packageId"
          ]
        }
      ]
    },
    {
      "name": "PackagePublishingService",
      "ops": [
        {
          "name": "PublishPackage",
          "params": [
            "packageId",
            "visibility"
          ]
        },
        {
          "name": "UnpublishPackage",
          "params": [
            "packageId"
          ]
        }
      ]
    },
    {
      "name": "PackageCatalogService",
      "ops": [
        {
