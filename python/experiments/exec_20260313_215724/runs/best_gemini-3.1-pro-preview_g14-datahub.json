{
  "microservices": [
    {
      "name": "IdentityService",
      "ops": [
        {
          "name": "SignUp",
          "params": [
            "email",
            "password"
          ]
        },
        {
          "name": "OAuthSignUp",
          "params": [
            "provider",
            "token"
          ]
        },
        {
          "name": "GetProfile",
          "params": [
            "userId"
          ]
        },
        {
          "name": "UpdateProfile",
          "params": [
            "userId",
            "profileData"
          ]
        }
      ]
    },
    {
      "name": "OrganizationService",
      "ops": [
        {
          "name": "InviteMember",
          "params": [
            "orgId",
            "email"
          ]
        },
        {
          "name": "RemoveMember",
          "params": [
            "orgId",
            "userId"
          ]
        },
        {
          "name": "UpdateRole",
          "params": [
            "orgId",
            "userId",
            "role"
          ]
        },
        {
          "name": "GetMembers",
          "params": [
            "orgId"
          ]
        }
      ]
    },
