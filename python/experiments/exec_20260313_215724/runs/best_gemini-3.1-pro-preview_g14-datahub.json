          "params": [
            "userId",
            "packageId"
          ]
        }
      ]
    },
    {
      "name": "BillingService",
      "ops": [
        {
          "name": "GetPricingPlans",
          "params": []
        },
        {
          "name": "SubscribeToPlan",
          "params": [
            "userId",
            "planId"
          ]
        }
      ]
    },
    {
