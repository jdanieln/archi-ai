      "ops": [
        {
          "name": "UpdateSiteConfig",
          "params": [
            "configKey",
            "configValue"
          ]
        },
        {
          "name": "GetSiteConfig",
          "params": [
            "configKey"
          ]
        }
      ]
    }
  ],
  "calls": [
    {
      "caller": "PackageRegistryService",
      "callee": "DataValidationService"
    },
    {
      "caller": "PackageRegistryService",
      "callee": "PackageVersioningService"
    },
    {
      "caller": "PackagePublishingService",
      "callee": "PackageRegistryService"
    },
    {
      "caller": "PackagePublishingService",
      "callee": "PackageCatalogService"
    },
    {
      "caller": "PackagePublishingService",
      "callee": "NotificationService"
    },
    {
      "caller": "StorageService",
      "callee": "AnalyticsService"
    },
    {
      "caller": "OrganizationService",
      "callee": "NotificationService"
    },
    {
      "caller": "IdentityService",
      "callee": "BillingService"
    },
    {
      "caller": "PreviewService",
      "callee": "StorageService"
    },
    {
      "caller": "PackageCatalogService",
      "callee": "AnalyticsService"
    }
  ]
