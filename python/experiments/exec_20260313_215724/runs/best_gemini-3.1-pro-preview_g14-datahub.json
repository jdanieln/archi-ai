          "params": [
            "packageId",
            "version",
            "format"
          ]
        },
        {
          "name": "DownloadAsSQLite",
          "params": [
            "packageId",
            "version"
          ]
        }
      ]
    },
    {
      "name": "PreviewService",
      "ops": [
        {
          "name": "PreviewPackage",
          "params": [
            "packageData"
          ]
        },
        {
          "name": "ListExamples",
          "params": []
        }
      ]
    },
    {
      "name": "AnalyticsService",
      "ops": [
        {
          "name": "RecordDownload",
          "params": [
            "packageId"
          ]
        },
        {
          "name": "GetPackageMetrics",
          "params": [
            "packageId"
          ]
        },
        {
          "name": "GetPlatformMetrics",
          "params": []
        }
      ]
    },
